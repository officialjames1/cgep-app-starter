                    "text": "Signed pipeline bundle containing terraform plan.json."
                  }
                ]
              },
              {
                "uuid": "77c84277-7f19-486d-9471-a8d4269a14f1",
                "control-id": "ac-3",
                "description": "Public access to the bucket is blocked at the account/bucket level via aws_s3_bucket_public_access_block. Hardcoded; consumers cannot override.",
                "props": [
                  { "name": "implementation-status", "value": "implemented" },
                  { "name": "terraform-resource", "value": "aws_s3_bucket_public_access_block.primary" }
                ],
                "links": [
                  {
